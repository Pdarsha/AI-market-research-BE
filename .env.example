PROJECT_NAME="your-project-name"
API_V1_STR="/v1"
DEBUG=True
FASTAPI_CONFIG="development"

# Database Connection (PostgreSQL with pgvector)
# PostgreSQL is required: embeddings are stored with pgvector (needs the "vector"
# extension, enabled by the Alembic migration). SQLite is no longer supported.
SQLALCHEMY_DATABASE_URI="postgresql+psycopg2://<db_user>:<db_password>@<db_host>:5432/<db_name>"

# JWT Secret Key (Generate a secure random string)
AUTH_TOKEN="<your-secure-random-string>"
ACCESS_TOKEN_EXPIRE_MINUTES=20160
REFRESH_TOKEN_EXPIRE_MINUTES=40320

# Google OAuth 2.0 client ID (from Google Cloud Console). Google ID tokens sent to
# POST /v1/user/google-login must have this as their audience.
GOOGLE_CLIENT_ID="<your-google-client-id>"

# OpenAI / OpenRouter Configuration
OPENAI_API_KEY="<your-api-key>"
OPENAI_BASE_URL="<your-openai-compatible-base-url>"
LLM_MODEL="<model-name>"
THINK_LONGER_MODEL="<model-name>"
DEEP_RESEARCH_MODEL="<model-name>"
EMBEDDING_MODEL="<embedding-model-name>"
EMBEDDING_DIMENSIONS=1536
RERANK_MODEL="<model-name>"

# OCR Settings (rapidocr uses pure Python ONNX runtime)
OCR_ENABLED=true
OCR_ENGINE="rapidocr"

# External API Integrations (Optional / As needed)
SERPAPI_KEY="<your-serpapi-key>"
# SEC requires a descriptive User-Agent: "<Company Name> <contact-email>"
SEC_EDGAR_USER_AGENT="<Company Name> <contact-email>"
ROIC_API_KEY="<your-roic-api-key>"
COMPANIES_HOUSE_API_KEY="<your-companies-house-api-key>"
ALPHA_VANTAGE_API_KEY="<your-alpha-vantage-api-key>"

# Mail / SMTP Settings (For OTPs and Scheduled Reports)
# if you're using zoho then you need to give User ID of that particular mail (find it at user's info in mailadmin console https://mailadmin.zoho.com/)
# e.g. if your email is user@example.com then MAIL_USERNAME will be user
MAIL_USERNAME="<your-mail-username>"

# Zoho allows providing plain password. but if you have two factor auth on then you need to pass application specific password.(get it from https://accounts.zoho.com/home#security/)
# for gmail: manage google account > security and enable 2 factor auth > add application and copy 16 character password string > paste it in MAIL_PASSWORD
MAIL_PASSWORD="<your-mail-app-password>"

# your full email address this will behave as a sender address
MAIL_FROM="<sender@example.com>"

MAIL_PORT=587
MAIL_SERVER="<smtp.example.com>"
