DEBUG=True
FASTAPI_CONFIG="development"
# PostgreSQL is required: embeddings are stored with pgvector (needs the "vector"
# extension, enabled by the Alembic migration). SQLite is no longer supported.
SQLALCHEMY_DATABASE_URI="postgresql+psycopg2://postgres:postgres@localhost:5432/agentic_ai"
AUTH_TOKEN="test"

# Google OAuth 2.0 client ID (from Google Cloud Console). Google ID tokens sent to
# POST /v1/user/google-login must have this as their audience.
GOOGLE_CLIENT_ID=""

# if you're using zoho then you need to give User ID of that particular mail (find it at user's info in mailadmin console https://mailadmin.zoho.com/)
# if your gmail is jayshreeram@ayodhya.com then MAIL_USERNAME will be jayshreeram
MAIL_USERNAME="jayshreeram"

# Zoho allows providing plain password. but f you have two factor auth on then you need to pass application specific password.(get it from https://accounts.zoho.com/home#security/)
# got to manage google account > security and enable 2 factor auth > add application and copy 16 character password string > paste it in MAIL_PASSWORD
MAIL_PASSWORD="<aaaabbbbccccdddd>"

# your full email address this will behave as a sender address
MAIL_FROM="jayshreeram@ayodhya.com"

MAIL_PORT=465
MAIL_SERVER=smtp.gmail.com
